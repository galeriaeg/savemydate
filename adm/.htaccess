#RewriteEngine On
#RewriteCond %{SCRIPT_FILENAME} !-f
#RewriteCond %{SCRIPT_FILENAME} !-d

#Redireciona para o HTTPS independente do domínio
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

#Adiciona www. no prefixo do domínio
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


#URL AMIGAVEL
RewriteEngine on
RewriteRule ^home/?$ index.php [NC,L]
RewriteRule ^convidados/?$ pages/convidados/index.php [NC,L]
RewriteRule ^pagamento/?$ pages/pagamento/index.php [NC,L]
RewriteRule ^analisa/?$ pages/pagamento/analisa-pagamento.php [NC,L]
RewriteRule ^confirma/?$ pages/pagamento/confirma.php [NC,L]
RewriteRule ^perfil/?$ pages/usuario/index.php [NC,L]
RewriteRule ^evento/?$ pages/evento/index.php [NC,L]
RewriteRule ^edita/?$ pages/evento/edita.php [NC,L]
RewriteRule ^upload-anexo/?$ pages/evento/upload-anexo.php [NC,L]
RewriteRule ^remove-anexo/?$ pages/evento/remove-anexo.php [NC,L]
RewriteRule ^logout/?$ logout.php [NC,L]



