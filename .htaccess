RewriteEngine On
#RewriteCond %{SCRIPT_FILENAME} !-f
#RewriteCond %{SCRIPT_FILENAME} !-d

#Redireciona para o HTTPS independente do domínio
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

#Adiciona www. no prefixo do domínio
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# AREA LOGIN
RewriteEngine on
RewriteRule ^home/?$ index.php [NC,L]
RewriteRule ^authentic/?$ aut.php [NC,L]
RewriteRule ^form-recover-pass/?$ form-recuperar-senha.php [NC,L]
RewriteRule ^recover-pass/?$ solicitar-senha.php [NC,L]

ErrorDocument 404 http://localhost/savemydate/erros/404.html

